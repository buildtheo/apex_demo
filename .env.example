# Configure locally; do not commit real account identifiers or credentials.
APEX_AUTH_MODE=oauth
# Synthetic demo only: opt in to draft staging + action-result read, never execution.
APEX_ENABLE_STAGING=0
APEX_INTAKE_MODEL=gpt-5.4-mini
# For a synthetic-only demo, set APEX_AUTH_MODE=demo (no OAuth/user verification).
# Reuse API credentials from an existing local file; never commit its contents.
# APEX_OPENAI_ENV_FILE=/absolute/path/to/existing/.env.local
# Optional synthetic phone alternative; also reads selected Twilio credentials
# from that private file. See docs/phone-setup.md; never commit actual values.
APEX_PHONE_ENABLED=0
APEX_REALTIME_MODEL=gpt-realtime-2.1
APEX_REALTIME_VOICE=cedar
# APEX_SUPPORT_CODE=your-private-four-digit-demo-code
# If omitted, phone configuration references DRIVER_SOFT_PIN in the private
# APEX_OPENAI_ENV_FILE, reusing the authorized M. Price demo support code.
APEX_MCP_ORIGIN=https://your-authenticated-adapter.example
APEX_OAUTH_ISSUER=https://your-existing-identity-provider.example/
APEX_OAUTH_AUDIENCE=https://your-authenticated-adapter.example/mcp
APEX_OAUTH_JWKS_URL=https://your-existing-identity-provider.example/.well-known/jwks.json
APEX_ACCESS_FILE=.local/access.json
