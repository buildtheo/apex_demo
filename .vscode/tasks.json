{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Apex: Run demo",
      "type": "process",
      "command": "python3",
      "args": ["server.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Apex: Run tests",
      "type": "process",
      "command": "python3",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
